# ==========================================================
# Git Ignore Configuration - Financial Tracker
# Melindungi token, kredensial, dan data sensitif dari GitHub
# ==========================================================

# 1. Environment & Secrets (Lokal Pribadi)
.env
.env.*
.env.local
.env.*.local
*.env
secrets.*
*.secret

# KECUALIKAN template publik agar tetap bisa di-upload ke GitHub:
!.env.example

# 2. Clasp & Apps Script Project ID
.clasp.json
.claspignore

# 3. OAuth, Service Account Credentials & Token Files
credentials.json
credential*.json
client_secret*.json
service-account*.json
oauth*.json
token*.json
*.pem
*.key
*.p12

# 4. Data Pribadi, Backup & Ekspor
data/
exports/
backups/
attachments/
*.csv
*.xlsx
*.pdf

# 5. Node & Testing Artifacts
node_modules/
coverage/
*.lcov
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 6. Log & File Sistem / Editor
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
