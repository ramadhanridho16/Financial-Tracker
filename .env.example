# ==========================================================
# Financial Tracker Pro - Environment Variables Template
# ==========================================================
# PANDUAN PENGGUNAAN:
# 1. Salin (copy) file ini menjadi file bernama '.env':
#    cp .env.example .env  (Linux/Mac) atau copy .env.example .env (Windows)
# 2. Isi nilai rahasia Anda pada file '.env'.
# 3. File '.env' SUDAH masuk ke dalam .gitignore sehingga TIDAK AKAN
#    terekspos atau ter-upload ke repositori GitHub publik.
# 4. File '.env.example' ini AMAN untuk di-commit dan di-push ke GitHub.
# ==========================================================

# 1. Konfigurasi Telegram Bot
# Dapatkan token bot Anda secara gratis melalui @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ID Akun Telegram yang berhak mengakses dan mencatat transaksi ke bot (pisahkan koma jika lebih dari 1)
# Dapatkan ID Anda via bot @userinfobot di Telegram
TELEGRAM_ALLOWED_USER_ID=12345678,87654321

# Chat ID default untuk pengiriman laporan atau notifikasi otomatis
TELEGRAM_DEFAULT_CHAT_ID=12345678

# 2. Konfigurasi Google Spreadsheet
# ID Spreadsheet utama (terdapat pada URL browser: https://docs.google.com/spreadsheets/d/<ID>/edit)
SPREADSHEET_ID=your_financial_tracker_spreadsheet_id_here

# ID Spreadsheet inventaris rumah tangga (jika mengintegrasikan modul Home Inventory)
HOME_INVENTORY_SPREADSHEET_ID=your_home_inventory_spreadsheet_id_here

# 3. Pengaturan Siklus Keuangan
# Tanggal hari gajian untuk perhitungan siklus reset budget bulanan (default: 25)
PAYDAY_DATE=25

# Wallet/Rekening default jika tidak disebutkan saat mencatat transaksi
DEFAULT_WALLET=BCA
